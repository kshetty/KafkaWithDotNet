# Production Environment Configuration

# Subscription and Tenant
subscription_id = "your-subscription-id-here"
tenant_id       = "your-tenant-id-here"

# Project Configuration
project_name = "kafkadotnet"
environment  = "prod"
location     = "eastus"

# Tags
tags = {
  CostCenter = "Production"
  Owner      = "Platform Team"
  Compliance = "GDPR"
}

# Networking
vnet_address_space = ["10.2.0.0/16"]

# PostgreSQL Configuration
postgresql_version    = "17"
postgresql_sku_name   = "GP_Standard_D4s_v3" # General Purpose: 4 vCores, 16 GiB RAM
postgresql_storage_mb = 131072               # 128 GB

# Redis Configuration
redis_sku_name  = "Premium"
redis_family    = "P"
redis_capacity  = 1 # 6 GB with Redis persistence
redis_version   = "6"

# Container Apps Configuration
container_apps_workload_profile = "Consumption"
container_apps_min_replicas     = 3
container_apps_max_replicas     = 10

# API Management Configuration
apim_sku_name        = "Standard_1" # or Premium_1 for multi-region, VNet support
apim_publisher_name  = "Kafka DotNet Production"
apim_publisher_email = "production@example.com"

# Azure Container Registry
acr_sku = "Premium" # Premium for geo-replication and advanced security

# Key Vault
key_vault_sku_name = "premium" # Premium for HSM-backed keys

# Monitoring
log_analytics_retention_days      = 90
application_insights_retention_days = 365

# Entra External ID (Azure AD B2C)
entra_external_id_domain = "your-tenant.onmicrosoft.com"
entra_client_id          = "your-client-id-here"
entra_client_secret      = "your-client-secret-here" # Use Key Vault or env var in production

# Azure AD B2C Configuration
b2c_tenant_id      = "your-b2c-tenant-id-here"
b2c_domain         = "userservice-prod.b2clogin.com"
b2c_api_client_id  = "your-b2c-api-client-id-here"
