# Staging Environment Configuration

# Subscription and Tenant
subscription_id = "your-subscription-id-here"
tenant_id       = "your-tenant-id-here"

# Project Configuration
project_name = "kafkadotnet"
environment  = "staging"
location     = "eastus"

# Tags
tags = {
  CostCenter = "Engineering"
  Owner      = "Platform Team"
}

# Networking
vnet_address_space = ["10.1.0.0/16"]

# PostgreSQL Configuration
postgresql_version    = "17"
postgresql_sku_name   = "GP_Standard_D2s_v3" # General Purpose: 2 vCores, 8 GiB RAM
postgresql_storage_mb = 65536                # 64 GB

# Redis Configuration
redis_sku_name  = "Standard"
redis_family    = "C"
redis_capacity  = 1 # 1 GB
redis_version   = "6"

# Container Apps Configuration
container_apps_workload_profile = "Consumption"
container_apps_min_replicas     = 2
container_apps_max_replicas     = 5

# API Management Configuration
apim_sku_name        = "Basic_1"
apim_publisher_name  = "Kafka DotNet Staging Team"
apim_publisher_email = "staging-team@example.com"

# Azure Container Registry
acr_sku = "Standard"

# Key Vault
key_vault_sku_name = "standard"

# Monitoring
log_analytics_retention_days      = 60
application_insights_retention_days = 180

# Entra External ID (Azure AD B2C)
entra_external_id_domain = "your-tenant.onmicrosoft.com"
entra_client_id          = "your-client-id-here"
entra_client_secret      = "your-client-secret-here" # Use Key Vault or env var in production

# Azure AD B2C Configuration
b2c_tenant_id      = "your-b2c-tenant-id-here"
b2c_domain         = "userservice-staging.b2clogin.com"
b2c_api_client_id  = "your-b2c-api-client-id-here"
