# ============================================================================
# Docker Compose Environment Variables Example
# ============================================================================
# Copy this file to .env and update with your actual values
# SECURITY WARNING: Never commit the .env file to version control
# ============================================================================

# ============================================================================
# INFRASTRUCTURE SERVICES
# ============================================================================

# ----------------------------------------------------------------------------
# PostgreSQL Configuration
# ----------------------------------------------------------------------------
POSTGRES_DB=userservice
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Connection String (Auto-constructed, can be overridden)
# Format: Host={POSTGRES_HOST};Port={POSTGRES_PORT};Database={POSTGRES_DB};Username={POSTGRES_USER};Password={POSTGRES_PASSWORD}
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=userservice;Username=postgres;Password=postgres_password;Include Error Detail=true

# ----------------------------------------------------------------------------
# Redis Configuration
# ----------------------------------------------------------------------------
REDIS_PASSWORD=redis_password
REDIS_HOST=redis
REDIS_PORT=6379

# Redis Connection String (Auto-constructed, can be overridden)
# Format: {REDIS_HOST}:{REDIS_PORT},password={REDIS_PASSWORD},abortConnect=false
ConnectionStrings__RedisConnection=redis:6379,password=redis_password,abortConnect=false

# Redis Cache Settings
REDIS_DEFAULT_EXPIRY_MINUTES=60
REDIS_SESSION_EXPIRY_MINUTES=30
REDIS_MAX_RETRIES=3

# ----------------------------------------------------------------------------
# Kafka Configuration
# ----------------------------------------------------------------------------
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_BROKER_HOST=kafka
KAFKA_BROKER_PORT=9092
KAFKA_CONTROLLER_PORT=9093

# Kafka Connection String
Kafka__BootstrapServers=kafka:9092

# Kafka Topics
Kafka__Topics__UserRegistered=user.registered
Kafka__Topics__UserSignedIn=user.signedin
Kafka__Topics__UserSignedOut=user.signedout
Kafka__Topics__UserUpdated=user.updated
Kafka__Topics__UserDeleted=user.deleted

# Kafka Producer Settings
Kafka__Producer__Acks=all
Kafka__Producer__Retries=3
Kafka__Producer__CompressionType=snappy
Kafka__Producer__IdempotenceEnabled=true

# Kafka Consumer Settings
Kafka__Consumer__GroupId=userservice-consumer-group
Kafka__Consumer__AutoOffsetReset=earliest
Kafka__Consumer__EnableAutoCommit=false

# ============================================================================
# MANAGEMENT UI SERVICES
# ============================================================================

# ----------------------------------------------------------------------------
# pgAdmin Configuration
# ----------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin_password
PGADMIN_PORT=5050

# ----------------------------------------------------------------------------
# Kafka UI Configuration
# ----------------------------------------------------------------------------
KAFKA_UI_PORT=8080

# ----------------------------------------------------------------------------
# Redis Commander Configuration
# ----------------------------------------------------------------------------
REDIS_COMMANDER_PORT=8081

# ============================================================================
# USER SERVICE APPLICATION
# ============================================================================

# ----------------------------------------------------------------------------
# ASP.NET Core Configuration
# ----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:80
USERSERVICE_PORT=5001

# Logging Configuration
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
Logging__LogLevel__Microsoft.EntityFrameworkCore=Information
Logging__LogLevel__System=Warning

# ----------------------------------------------------------------------------
# JWT Authentication Configuration
# ----------------------------------------------------------------------------
# SECURITY WARNING: These are development values only
# In production, use Azure Key Vault for secret management
JWT_SECRET_KEY=your-secret-key-must-be-at-least-32-characters-long-for-hs256
JWT_ISSUER=https://localhost:5001
JWT_AUDIENCE=https://localhost:5001
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7
JWT_CLOCK_SKEW_MINUTES=5

# JWT Settings (Alternative naming convention)
JwtSettings__SecretKey=${JWT_SECRET_KEY}
JwtSettings__Issuer=${JWT_ISSUER}
JwtSettings__Audience=${JWT_AUDIENCE}
JwtSettings__ExpiryMinutes=${JWT_EXPIRY_MINUTES}
JwtSettings__RefreshTokenExpiryDays=${JWT_REFRESH_TOKEN_EXPIRY_DAYS}
JwtSettings__ClockSkewMinutes=${JWT_CLOCK_SKEW_MINUTES}

# ----------------------------------------------------------------------------
# Microsoft Entra External ID (Azure AD B2C) Configuration
# ----------------------------------------------------------------------------
AZURE_AD_INSTANCE=https://login.microsoftonline.com/
AZURE_AD_TENANT_ID=your-tenant-id-guid
AZURE_AD_CLIENT_ID=your-client-id-guid
AZURE_AD_CLIENT_SECRET=your-client-secret
AZURE_AD_DOMAIN=your-domain.onmicrosoft.com
AZURE_AD_SIGNUP_SIGNIN_POLICY=B2C_1_SignUpSignIn
AZURE_AD_CALLBACK_PATH=/signin-oidc

# Azure AD Settings (Alternative naming convention)
AzureAd__Instance=${AZURE_AD_INSTANCE}
AzureAd__TenantId=${AZURE_AD_TENANT_ID}
AzureAd__ClientId=${AZURE_AD_CLIENT_ID}
AzureAd__ClientSecret=${AZURE_AD_CLIENT_SECRET}
AzureAd__Domain=${AZURE_AD_DOMAIN}
AzureAd__SignUpSignInPolicyId=${AZURE_AD_SIGNUP_SIGNIN_POLICY}
AzureAd__CallbackPath=${AZURE_AD_CALLBACK_PATH}

# ----------------------------------------------------------------------------
# CORS Configuration
# ----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_ALLOW_CREDENTIALS=true

# CORS Settings (Alternative naming convention)
CorsSettings__AllowedOrigins=${CORS_ALLOWED_ORIGINS}
CorsSettings__AllowedMethods=${CORS_ALLOWED_METHODS}
CorsSettings__AllowedHeaders=${CORS_ALLOWED_HEADERS}
CorsSettings__AllowCredentials=${CORS_ALLOW_CREDENTIALS}

# ----------------------------------------------------------------------------
# API Rate Limiting Configuration
# ----------------------------------------------------------------------------
RateLimiting__Enabled=true
RateLimiting__PermitLimit=100
RateLimiting__Window=00:01:00
RateLimiting__QueueLimit=10

# ----------------------------------------------------------------------------
# Password Policy Configuration
# ----------------------------------------------------------------------------
PasswordPolicy__MinimumLength=8
PasswordPolicy__RequireDigit=true
PasswordPolicy__RequireLowercase=true
PasswordPolicy__RequireUppercase=true
PasswordPolicy__RequireNonAlphanumeric=true
PasswordPolicy__MaxFailedAttempts=5
PasswordPolicy__LockoutDurationMinutes=15

# ----------------------------------------------------------------------------
# Session Configuration
# ----------------------------------------------------------------------------
Session__IdleTimeout=00:30:00
Session__CookieName=.UserService.Session
Session__CookieSecure=true
Session__CookieHttpOnly=true
Session__CookieSameSite=Strict

# ----------------------------------------------------------------------------
# Email Configuration (for future use)
# ----------------------------------------------------------------------------
Email__SmtpServer=smtp.example.com
Email__SmtpPort=587
Email__UseSsl=true
Email__FromEmail=noreply@example.com
Email__FromName=User Service
Email__Username=your-smtp-username
Email__Password=your-smtp-password

# ----------------------------------------------------------------------------
# Health Checks Configuration
# ----------------------------------------------------------------------------
HealthChecks__Enabled=true
HealthChecks__Endpoint=/health
HealthChecks__DetailedErrors=true

# ----------------------------------------------------------------------------
# Swagger/OpenAPI Configuration
# ----------------------------------------------------------------------------
Swagger__Enabled=true
Swagger__Title=User Service API
Swagger__Version=v1
Swagger__Description=Authentication and User Management API
Swagger__ContactName=Your Team
Swagger__ContactEmail=team@example.com

# ============================================================================
# MONITORING & OBSERVABILITY (Optional - Azure Application Insights)
# ============================================================================

# ----------------------------------------------------------------------------
# Application Insights Configuration
# ----------------------------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-instrumentation-key;IngestionEndpoint=https://your-region.in.applicationinsights.azure.com/
ApplicationInsights__ConnectionString=${APPLICATIONINSIGHTS_CONNECTION_STRING}
ApplicationInsights__EnableAdaptiveSampling=true
ApplicationInsights__SamplingPercentage=50

# ----------------------------------------------------------------------------
# Azure Monitor Configuration
# ----------------------------------------------------------------------------
AzureMonitor__WorkspaceId=your-workspace-id
AzureMonitor__WorkspaceKey=your-workspace-key

# ============================================================================
# FEATURE FLAGS (Optional)
# ============================================================================
FeatureFlags__EnableRegistration=true
FeatureFlags__EnableSocialLogin=false
FeatureFlags__EnableEmailVerification=false
FeatureFlags__EnableTwoFactorAuth=false
FeatureFlags__MaintenanceMode=false

# ============================================================================
# ADDITIONAL SETTINGS
# ============================================================================

# ----------------------------------------------------------------------------
# Localization
# ----------------------------------------------------------------------------
Localization__DefaultCulture=en-US
Localization__SupportedCultures=en-US,es-ES,fr-FR

# ----------------------------------------------------------------------------
# File Upload (for future use)
# ----------------------------------------------------------------------------
FileUpload__MaxFileSizeBytes=5242880
FileUpload__AllowedExtensions=.jpg,.jpeg,.png,.gif
FileUpload__StoragePath=/app/uploads

# ----------------------------------------------------------------------------
# API Versioning
# ----------------------------------------------------------------------------
ApiVersioning__DefaultVersion=1.0
ApiVersioning__AssumeDefaultVersionWhenUnspecified=true

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================

# ----------------------------------------------------------------------------
# Database Seeding
# ----------------------------------------------------------------------------
DatabaseSeeding__Enabled=true
DatabaseSeeding__CreateTestUsers=true

# ----------------------------------------------------------------------------
# Development Settings
# ----------------------------------------------------------------------------
Development__ShowExceptionDetails=true
Development__EnableSensitiveDataLogging=true
Development__EnableDetailedErrors=true

# ============================================================================
# NOTES
# ============================================================================
# 1. Generate a new JWT secret key using: openssl rand -base64 32
# 2. Generate a new Kafka cluster ID using: kafka-storage.sh random-uuid
# 3. For production, use Azure Key Vault for all secrets
# 4. Update CORS origins to match your frontend URLs
# 5. Configure Azure AD B2C after setting up your tenant
# 6. Review and adjust rate limiting values based on your needs
# 7. Enable Application Insights for production monitoring
# ============================================================================
